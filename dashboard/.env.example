DATABASE_URL=postgresql://bugbounty:bugbounty_secret@localhost:5432/bugbounty
BOT_API_URL=http://localhost:8080
SCAN_SERVICE_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:3000

# Shared secret used by:
#   - Dashboard UI login (cookie auth)
#   - Dashboard <-> scan_service Bearer auth (both directions)
# REQUIRED. Must be at least 16 characters. Empty values are rejected.
# Generate with: openssl rand -hex 32
DASHBOARD_TOKEN=replace-me-with-a-32-byte-hex-secret

# Comma-separated origins allowed to hit scan_service /api/* via CORS.
# Defaults to localhost:3000 if unset.
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000

NEXTAUTH_SECRET=change-me-in-production
