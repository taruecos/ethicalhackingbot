DATABASE_URL=postgresql://bugbounty:bugbounty_secret@localhost:5432/bugbounty
BOT_API_URL=http://localhost:8080
SCAN_SERVICE_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:3000

# Shared secret used by:
#   - Dashboard UI login (cookie auth)
#   - Dashboard <-> scan_service Bearer auth (both directions)
# REQUIRED. Must be at least 16 characters. Empty values are rejected.
# Generate with: openssl rand -hex 32
DASHBOARD_TOKEN=replace-me-with-a-32-byte-hex-secret

# Comma-separated origins allowed to hit scan_service /api/* via CORS.
# Defaults to localhost:3000 if unset.
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000

NEXTAUTH_SECRET=change-me-in-production

# Cookies are sent over HTTPS only when NODE_ENV=production.
# Set to "false" ONLY if running prod over plain HTTP (e.g., behind a TLS proxy that strips https://).
COOKIE_SECURE=true

# Telegram alerting — dedicated bot that pings Tariq when high-value findings appear.
# Leave BOTH unset to run in stub mode (no Telegram calls, just logs).
# Create a bot via @BotFather, paste the token here, and put your chat id (or a group id) in TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Intigriti submission ──
# Researcher API token used to auto-submit CONFIRMED findings.
# Leave blank or set to "stub-mode" to operate in stub mode: the submitter
# logs intent and returns a fake id without making any HTTP call.
INTIGRITI_API_TOKEN=
INTIGRITI_API_URL=https://api.intigriti.com/external/researcher/v1

# ── Scheduled scans ──
# Bearer secret protecting POST /api/scans/scheduled (cron-style trigger).
# Required for that endpoint; the route returns 503 if unset.
# Cron caller sends: Authorization: Bearer ${CRON_SECRET}
# Generate with: openssl rand -hex 32
CRON_SECRET=
